------------MODEL DE DATE------------
Entități principale:

Airport(id, iata_code, name, city, country)

Airline(id, code, name)

Flight(id, airline_id, flight_number, origin_airport_id, destination_airport_id, scheduled_departure, scheduled_arrival, status[PLANNED|ON_TIME|DELAYED|CANCELLED])

Passenger(id, first_name, last_name, email, phone)

Booking(id, code[PNR], flight_id, passenger_id, status[HOLD|CONFIRMED|CANCELLED], price_total, created_at)

Ticket(id, booking_id, seat_id, fare_class_id, price)

Aircraft(id, model, seat_capacity)

FareClass(id, code [Y, M, B, J…], name)

Seat(id, flight_id, seat_no, class_id, is_available)